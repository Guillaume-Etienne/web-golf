# ==========================================================================
# Configuration serveur (hébergements Apache : OVH, o2switch, Ionos…)
# Sans effet sur les autres hébergeurs (Netlify, Cloudflare Pages…), qui ont
# leur propre format : voir AGENTS.md, « Mise en ligne ».
# ==========================================================================

# Page affichée pour une adresse inconnue
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Forcer HTTPS et le « www » (à activer une fois le certificat SSL en place)
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.dominiquetavernini.fr%{REQUEST_URI} [R=301,L]

  # --- Redirections 301 depuis les adresses de l'ancien site WordPress
  #     (conserve le référencement et les liens existants)
  RewriteRule ^accueil/?$ / [R=301,L]
  RewriteRule ^accueil/qui-suis-je/?$ /enseignant/ [R=301,L]
  RewriteRule ^accueil/ma-methode/?$ /enseignant/#methode [R=301,NE,L]
  RewriteRule ^accueil/lecons-individuelles-et-collectives/?$ /cours-et-tarifs/#lecons [R=301,NE,L]
  RewriteRule ^accueil/(prestations-et-tarifs/)?parcours-accompagnes/?$ /cours-et-tarifs/#parcours [R=301,NE,L]
  RewriteRule ^accueil/(prestations-et-tarifs/)?stages/petit-jeu(/.*)?$ /cours-et-tarifs/#petit-jeu [R=301,NE,L]
  RewriteRule ^accueil/prestations-et-tarifs/stages/carte-verte(/.*)?$ /cours-et-tarifs/#carte-verte [R=301,NE,L]
  RewriteRule ^accueil/(prestations-et-tarifs/)?stages(/.*)?$ /cours-et-tarifs/#stages [R=301,NE,L]
  RewriteRule ^accueil/prestations-et-tarifs/stages-juniors/?$ /cours-et-tarifs/ [R=301,L]
  RewriteRule ^accueil/(prestations-et-tarifs/)?perfectionnement(/.*)?$ /cours-et-tarifs/#perfectionnement [R=301,NE,L]
  RewriteRule ^accueil/prestations-et-tarifs/lecons-individuelles-et-collectives/?$ /cours-et-tarifs/#lecons [R=301,NE,L]
  RewriteRule ^accueil/prestations-et-tarifs/lecons-individuelles-et-collectives/.+$ /cours-et-tarifs/#perfectionnement [R=301,NE,L]
  RewriteRule ^accueil/prestations-et-tarifs/escapades-et-sejours/?$ /escapades-et-sejours/ [R=301,L]
  RewriteRule ^accueil/prestations-et-tarifs/?$ /cours-et-tarifs/ [R=301,L]
  RewriteRule ^accueil/actualites/?$ /escapades-et-sejours/ [R=301,L]
  RewriteRule ^accueil/contact/?$ /contact/ [R=301,L]
</IfModule>

# --- Compression des fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>

# --- Durée de cache dans le navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  # Pages HTML : toujours vérifier la dernière version
  ExpiresByType text/html "access plus 0 seconds"
  # CSS et JS (noms de fichiers fixes) : cache court pour voir vite les mises à jour
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  # Images et polices : changent rarement
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Types de fichiers récents (certains serveurs ne les connaissent pas)
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2

# --- Ne pas servir les fichiers de documentation du dépôt
<FilesMatch "^(AGENTS|CLAUDE|CREDITS)\.md$">
  Require all denied
</FilesMatch>
